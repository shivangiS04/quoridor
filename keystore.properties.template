## Copy to keystore.properties (git-ignored) or point QUORIDOR_KEYSTORE_PROPERTIES at your own file.
## Create a key once with:
##   keytool -genkeypair -v -keystore quoridor-release.jks -storetype PKCS12 -alias quoridor \
##           -keyalg RSA -keysize 2048 -validity 10000
## Keep the .jks and its passwords safe and BACKED UP: apps signed with a different key cannot update installs.
storeFile=/absolute/path/to/quoridor-release.jks
storePassword=change-me
keyAlias=quoridor
keyPassword=change-me
